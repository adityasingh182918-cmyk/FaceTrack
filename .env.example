# Local backend development only. Replace placeholders before use.
FACETRACK_ENV=development
# FACETRACK_DATA_DIR=./data
FACETRACK_ADMIN_USERNAME=admin
FACETRACK_ADMIN_PASSWORD=replace-with-a-strong-local-password
FACETRACK_JWT_SECRET=replace-with-at-least-32-random-characters
FACETRACK_ALLOWED_ORIGINS=http://localhost:5173
FACETRACK_BACKEND_API_URL=http://127.0.0.1:8000/api
FACETRACK_DEV_API_TARGET=http://127.0.0.1:8000

# Public Vercel build-time value; set to the Render API origin plus /api.
VITE_API_BASE_URL=https://your-render-service.onrender.com/api
